# Скопируйте этот файл в .env и измените значения под свой сервер.
# Файл .env не попадёт в GitHub.

# Папки на сервере
PHOTO_REVIEW_PHOTOS=/srv/photos
PHOTO_REVIEW_QUARANTINE=/srv/photo-quarantine
PHOTO_REVIEW_DATA=./photo-review-data

# Доступ к приложению. Используйте длинные уникальные значения.
PHOTO_REVIEW_PASSWORD=change-this-password
PHOTO_REVIEW_SESSION_SECRET=replace-with-a-long-random-string
# true — показывать вход; false — отключить вход для домашней сети.
PHOTO_REVIEW_AUTH_ENABLED=true

# Сеть и ресурсы
PHOTO_REVIEW_PORT=8088
PHOTO_REVIEW_MEMORY=3G
PHOTO_REVIEW_CPUS=2.0
TZ=Etc/UTC
PHOTO_REVIEW_OCR_LANGS=rus+eng

# Необязательно: имя уже собранного образа.
# PHOTO_REVIEW_IMAGE=photo-review:local
