# Copy to .env and replace every *_HOST path and secret before production use.
PHOTO_REVIEW_ENV=production
PHOTO_REVIEW_PHOTOS_HOST=/absolute/path/to/photos
PHOTO_REVIEW_QUARANTINE_HOST=/absolute/path/to/quarantine
PHOTO_REVIEW_STATE_HOST=./photo-review-state
PHOTO_REVIEW_QUEUE_HOST=./photo-review-queue
PHOTO_REVIEW_STAGING_HOST=./photo-review-staging
PHOTO_REVIEW_PASSWORD=replace-with-a-strong-password
PHOTO_REVIEW_SESSION_SECRET=replace-with-a-long-random-secret
PHOTO_REVIEW_LOG_LEVEL=INFO
PHOTO_REVIEW_RETRY_COUNT=3
PHOTO_REVIEW_RETRY_DELAY_SECONDS=5
PHOTO_REVIEW_LOCK_TTL_SECONDS=60
PHOTO_REVIEW_LOCK_HEARTBEAT_SECONDS=20
PHOTO_REVIEW_OUTBOX_BATCH_SIZE=25
PHOTO_REVIEW_OUTBOX_MAX_ATTEMPTS=3
PHOTO_REVIEW_STARTUP_RECOVERY=true
